# Kaynak metinlerini tutarlı satır sonlarıyla sakla.
* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.ps1 text eol=lf

# cmd.exe için hazır CRLF baytlarını koru; GitHub kaynak ZIP'i de aynı betiği içersin.
*.cmd -text whitespace=cr-at-eol
*.otf binary

*.sh text eol=lf
*.py text eol=lf

*.json text eol=lf
